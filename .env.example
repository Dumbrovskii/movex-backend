# APP
TITLE="MoveX API"
VERSION="1.0.0"
ALLOW_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
ALLOW_CREDENTIALS=True
ALLOW_METHODS=["*"]
ALLOW_HEADERS=["*"]
ROUTER_PREFIX="/api/v1"

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAME=movex
POSTGRES_USER=movex
POSTGRES_PASSWORD=movex

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_NAME=0

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256

# OSRM
OSRM_HOST=http://localhost:5000

# Auth
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_SECONDS=300
MAX_VERIFICATION_ATTEMPTS=5

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30


LOG_LEVEL=INFO

# Pricing
RIDE_BASE_FARE=50
RIDE_PRICE_PER_KM=15